# Copy this file to .env and fill in your values. Never commit .env.
DISCORD_TOKEN=paste-your-bot-token-here

# Optional: comma-separated server IDs for instant slash-command updates while testing.
# Leave blank for normal use across multiple servers (commands sync globally).
GUILD_IDS=

# Optional: channel ID where the bot posts its own logs.
LOG_CHANNEL_ID=
# Minimum level posted to that channel: WARNING (problems only), INFO (activity too), ERROR
LOG_CHANNEL_LEVEL=WARNING

# Optional tuning
IDLE_TIMEOUT=300
MAX_PLAYLIST_ITEMS=100